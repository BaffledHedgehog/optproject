\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Сертифицированные старты при общем бюджете 1000 вызовов функции. Каждый незавершённый запуск достигает бюджета до лимита; завершённые результаты переносятся вперёд. В каждой ячейке Seoul 30 стартов, Metro 24. $F/A$: FW/AFW; индексы $1,U$: начальные $M=1,U_0/D^2$; $Q$: короткий шаг с известной кривизной; AC: автоматически обусловленный FW с оплаченной предварительной обработкой.}}{12}{table.2}\protected@file@percent }
\newlabel{tab:budget}{{2}{12}{Сертифицированные старты при общем бюджете 1000 вызовов функции. Каждый незавершённый запуск достигает бюджета до лимита; завершённые результаты переносятся вперёд. В каждой ячейке Seoul 30 стартов, Metro 24. $F/A$: FW/AFW; индексы $1,U$: начальные $M=1,U_0/D^2$; $Q$: короткий шаг с известной кривизной; AC: автоматически обусловленный FW с оплаченной предварительной обработкой}{table.2}{}}
