\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Поточечные теоретические границы. Дифференциальная огибающая сохраняет изменение значения функции вдоль отрезка; сравнение с фиксированной квадратичной моделью дано в~\eqref  {eq:sharpbridge}. При нулевой базовой кривизне точный линейный коэффициент равен $\sqrt  b\coth \sqrt  b$. Это неравенства для класса функций, а не траектории оптимизации или измерения времени.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:geometry}{{1}{7}{Поточечные теоретические границы. Дифференциальная огибающая сохраняет изменение значения функции вдоль отрезка; сравнение с фиксированной квадратичной моделью дано в~\eqref {eq:sharpbridge}. При нулевой базовой кривизне точный линейный коэффициент равен $\sqrt b\coth \sqrt b$. Это неравенства для класса функций, а не траектории оптимизации или измерения времени}{figure.1}{}}
