# Byte-hashed source snapshots must survive Windows checkout unchanged.
*.py text eol=lf
*.tex text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
# CSV writers may intentionally emit CRLF. Do not normalize experimental data.
*.csv -text
*.pdf binary
*.png binary
*.zip binary
*.gz binary
Data/** -text
# New evidence and publication files contain byte-level SHA-256 references.
# Preserve their original bytes across Windows/Linux checkouts.
Submission/** -text -whitespace
Work/endpoint_recovery_strict_results/** -text -whitespace
Work/exposed_face_recovery_results/** -text -whitespace
Work/endpoint_fw.py -text
Work/endpoint_benchmark.py -text
Work/exposed_face_recovery.py -text
